---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Menu from '@lucide/astro/icons/menu';
import { nav } from '../content/copy';
---

<header class="sticky top-0 z-40 border-b border-rule bg-bg">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" class="-m-1 rounded p-1 text-ink" aria-label="ModelPar home">
      <Logo height={20} />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 text-[15px] md:flex">
      {
        nav.links.map((l) => (
          <a href={l.href} class="text-ink-2 transition-colors hover:text-ink">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={nav.cta.href} class="btn btn-primary btn-sm hidden sm:inline-flex">{nav.cta.label}</a>
      <ThemeToggle />
      <details class="nav-menu relative md:hidden">
        <summary
          class="inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-rule text-ink-2 hover:text-ink"
          aria-label={nav.menu}
        >
          <Menu size={16} aria-hidden="true" />
        </summary>
        <div class="absolute right-0 top-11 w-60 rounded-lg border border-rule bg-surface p-2">
          <nav aria-label="Mobile" class="flex flex-col">
            {
              nav.links.map((l) => (
                <a href={l.href} class="rounded-md px-3 py-2.5 text-[15px] text-ink hover:bg-surface-2">
                  {l.label}
                </a>
              ))
            }
          </nav>
          <a href={nav.cta.href} class="btn btn-primary btn-sm mt-2 w-full justify-center">{nav.cta.label}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-menu summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  // Close the mobile menu after choosing a link.
  document.querySelectorAll<HTMLDetailsElement>('.nav-menu').forEach((d) =>
    d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => d.removeAttribute('open'))),
  );
</script>
