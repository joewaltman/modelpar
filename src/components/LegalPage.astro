---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { legal } from '../content/copy';
import { date } from '../lib/sample';

interface Props {
  page: 'privacy' | 'terms';
  title: string;
  description: string;
}
const { page, title, description } = Astro.props;
const doc = legal[page];
const vars: Record<string, string> = { brand: site.brand, city: site.city, email: site.email };
const f = (s: string) => s.replace(/\{(\w+)\}/g, (m, k) => vars[k] ?? m);
---

<Base title={title} description={description} path={`/${page}`}>
  <div class="wrap py-14 md:py-20">
    <div class="mx-auto max-w-[680px]">
      <h1 class="text-[36px] font-semibold tracking-[-0.02em] md:text-[44px]">{doc.heading}</h1>
      <p class="label mt-2">{legal.updated} {date(legal.lastUpdated)}</p>
      <p class="mt-6 text-[18px]">{f(doc.intro)}</p>
      {
        doc.sections.map((s) => (
          <section class="mt-10">
            <h2 class="text-[20px] font-semibold tracking-[-0.01em]">{s.h}</h2>
            {s.p.map((p) => (
              <p class="mt-3 text-ink-2">{f(p)}</p>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Base>
