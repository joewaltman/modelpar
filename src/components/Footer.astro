---
import Logo from './Logo.astro';
import { site } from '../config';
import { footer } from '../content/copy';
---

<footer class="border-t border-rule">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="/" class="inline-block text-ink" aria-label="ModelPar home"><Logo height={18} /></a>
      <p class="mt-4 max-w-sm text-[15px] text-ink-2">{footer.tagline}</p>
      <p class="mt-4 text-[15px]">
        <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <nav aria-label="Footer" class="md:col-span-7">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2.5 text-[15px] sm:grid-cols-3">
        {
          footer.links.map((l) => (
            <li>
              <a href={l.href} class="text-ink-2 hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex flex-col gap-2 border-t border-rule pt-6 text-[13px] text-ink-2 md:col-span-12 md:flex-row md:justify-between">
      <p class="num">
        © {new Date().getFullYear()} {site.brand} · {site.city} · {footer.updated} {site.updated}
      </p>
      <p class="max-w-xl md:text-right">{footer.disclaimer}</p>
    </div>
  </div>
</footer>
